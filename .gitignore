# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 运行数据（SQLite 快照库，不入库）
/data/
*.db
*.db-wal
*.db-shm

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Android 构建产物
android/.gradle/
android/build/
android/app/build/

# 签名密钥 / 安装包 / 本机签名配置（含口令，绝不入库）
*.jks
*.keystore
*.apk
# 发行版 APK 按本项目惯例入库（Release 附件的本地副本），其余安装包一律忽略
!releases/*.apk
/android/local.properties

# 预览/截图临时目录
.preview/
.cprofile/

# 预置行情库（随 APK 分发，需入库）
!android/app/src/main/assets/seed.db
